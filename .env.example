# Database connection (PostgreSQL with pgvector extension)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Query Embedding API configuration
# Either set EMBEDDING_API_KEY for Google Gemini default or provide EMBEDDING_API_URL directly
EMBEDDING_API_KEY=
EMBEDDING_API_URL=

# LLM-as-a-Judge API configuration (OpenAI-compatible chat completion endpoint)
JUDGE_API_KEY=
JUDGE_API_URL=https://api.openai.com/v1/chat/completions
