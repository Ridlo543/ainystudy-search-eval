# Database connection (PostgreSQL with pgvector extension)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Query Embedding API configuration (OpenAI-compatible / Cloudflare Workers AI embeddings)
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1/embeddings
EMBEDDING_MODEL=@cf/baai/bge-m3

# LLM-as-a-Judge API configuration (OpenAI-compatible chat completions)
JUDGE_API_KEY=
JUDGE_API_URL=https://api.openai.com/v1/chat/completions
JUDGE_MODEL=gpt-4o-mini
